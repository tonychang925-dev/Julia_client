# Copy to ~/.julia_ops/tunnel.env and fill host/port/key locally.
AUTODL_HOST=connect.example.seetacloud.com
AUTODL_PORT=22
AUTODL_USER=root
AUTODL_IDENTITY_FILE=/Users/admin/.ssh/julia_autodl_ed25519
VOICE_FRONTEND_BIND=127.0.0.1
VOICE_FRONTEND_PORT=7860
VOICE_S2S_BIND=127.0.0.1
VOICE_S2S_PORT=8765
TUNNEL_HEALTH_STATE_DIR=/Users/admin/.julia_ops/state
