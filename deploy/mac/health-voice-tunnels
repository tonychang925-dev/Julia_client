#!/usr/bin/env bash
set -euo pipefail
LABEL="com.julia.tunnel.voice-local"
ENV_FILE="${JULIA_TUNNEL_ENV:-$HOME/.julia_ops/tunnel.env}"
if [[ -f "$ENV_FILE" ]]; then
  set -a
  # shellcheck disable=SC1090
  source "$ENV_FILE"
  set +a
fi
: "${VOICE_FRONTEND_PORT:=7860}"
: "${VOICE_S2S_PORT:=8765}"
STATE_DIR="${TUNNEL_HEALTH_STATE_DIR:-$HOME/.julia_ops/state}"
mkdir -p "$STATE_DIR"
FAIL_FILE="$STATE_DIR/${LABEL}.failcount"
uid="$(id -u)"
frontend_ok=0
s2s_ok=0
if /usr/bin/curl --noproxy '*' -fsS --max-time 5 "http://127.0.0.1:${VOICE_FRONTEND_PORT}/" >/dev/null 2>&1; then
  frontend_ok=1
fi
if /usr/bin/curl --noproxy '*' -sS -o /dev/null --max-time 5 "http://127.0.0.1:${VOICE_S2S_PORT}/" >/dev/null 2>&1; then
  s2s_ok=1
fi
if [[ "$frontend_ok" == 1 && "$s2s_ok" == 1 ]]; then
  echo 0 > "$FAIL_FILE"
  echo "voice tunnels health PASS"
  exit 0
fi
count=0
[[ -f "$FAIL_FILE" ]] && count="$(cat "$FAIL_FILE" 2>/dev/null || echo 0)"
count=$((count + 1))
echo "$count" > "$FAIL_FILE"
echo "voice tunnels health FAIL count=$count frontend=$frontend_ok s2s=$s2s_ok" >&2
if [[ "$count" -ge 3 ]]; then
  echo 0 > "$FAIL_FILE"
  /bin/launchctl kickstart -k "gui/${uid}/${LABEL}" || true
fi
exit 1
