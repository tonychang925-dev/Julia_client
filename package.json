{
  "name": "julia-electron-v2",
  "version": "0.1.0",
  "description": "Julia Electron V2 — clean desktop shell for existing HF Web Voice",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "start:http": "JULIA_WEB_VOICE_URL=http://localhost:7860 electron .",
    "start:https": "JULIA_WEB_VOICE_URL=https://localhost:7860 electron .",
    "start:https:diagnostic:insecure-localhost": "JULIA_WEB_VOICE_URL=https://localhost:7860 JULIA_ALLOW_INSECURE_LOCALHOST_CERT=1 electron ."
  },
  "dependencies": {
    "electron": "^41.7.1"
  }
}
